<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="reportFoundRoot" styleClass="content-pane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.LnF.lostandfound.controller.ReportFoundController">

    <top>
        <TitledPane collapsible="false" text="Report Found Item">
            <BorderPane.margin>
                <Insets bottom="20.0" />
            </BorderPane.margin>
            <GridPane styleClass="form-grid">
                <Label text="Item Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="itemNameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Category:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="categoryBox" promptText="Select category..." GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="2000.0" />

                <Label text="Location Found:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="locationField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Found Date:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <DatePicker fx:id="datePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="2000.0" />

                <Label text="Color:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <TextField fx:id="colorField" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="Brand:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <TextField fx:id="brandField" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                <TextArea fx:id="descriptionArea" GridPane.rowIndex="2" GridPane.columnIndex="3" GridPane.rowSpan="2" prefHeight="80.0" />

                <Label text="Photo:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <VBox spacing="10" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2">
                    <ImageView fx:id="itemImageView" fitHeight="120" fitWidth="120" preserveRatio="true"
                               style="-fx-border-color: -fx-border-color; -fx-border-width: 1; -fx-border-radius: 6;" />
                    <Button onAction="#handleUploadPhoto" text="Upload Photo" />
                </VBox>

                <HBox alignment="BOTTOM_RIGHT" spacing="10.0" GridPane.rowIndex="5" GridPane.columnIndex="3">
                    <Button onAction="#clearForm" text="Clear" />
                    <Button onAction="#submitReport" text="Report Found" styleClass="button-primary" />
                </HBox>

                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                    <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                </columnConstraints>
            </GridPane>
        </TitledPane>
    </top>

    <center>
        <TitledPane collapsible="false" text="My Found Items" VBox.vgrow="ALWAYS">
            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <TableView fx:id="myFoundItemsTable" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No found items reported yet." />
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
                        <TableColumn fx:id="colItemName" text="Item Name" prefWidth="150.0" />
                        <TableColumn fx:id="colCategory" text="Category" prefWidth="100.0" />
                        <TableColumn fx:id="colLocation" text="Location" prefWidth="150.0" />
                        <TableColumn fx:id="colDate" text="Date" prefWidth="100.0" />
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="80.0" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button onAction="#refreshTable" text="Refresh" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#findMatches" text="Find Matches" />
                    <Button onAction="#deleteItem" text="Delete" styleClass="button-danger" />
                </HBox>
            </VBox>
        </TitledPane>
    </center>


</BorderPane>